{
  "name": "libretranslate-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing a self-hosted LibreTranslate instance: translate, detect, languages.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "libretranslate-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "test:smoke:stdio": "node scripts/smoke-stdio.mjs",
    "start": "node dist/index.js",
    "start:stdio": "TRANSPORT=stdio node dist/index.js",
    "start:http": "TRANSPORT=http node dist/index.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "libretranslate",
    "translation",
    "self-hosted"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
