# libretranslate-mcp — environment template
# Copy to .env and adjust. Values below are the built-in defaults.

# --- Upstream LibreTranslate ------------------------------------------------
# Base URL of the LibreTranslate instance, no trailing slash.
LIBRETRANSLATE_URL=http://localhost:5000
# Per-request timeout. The default is generous because model warm-up on a
# freshly started LibreTranslate container can exceed a short timeout.
LIBRETRANSLATE_TIMEOUT_MS=60000

# --- Transport --------------------------------------------------------------
# stdio (default) or http. Use http when the server runs in a container.
TRANSPORT=stdio
# Container port for the http transport. Ignored by the stdio transport.
PORT=8787

# --- HTTP security ----------------------------------------------------------
# Bearer token required on POST /mcp. Leave empty to DISABLE authentication,
# which is only acceptable when the port stays inside a private network.
# Generate one with: openssl rand -hex 32
AUTH_TOKEN=

# Maximum accepted request body for POST /mcp, in bytes (default 1 MiB).
# Enforced while reading; larger bodies get 413 and the connection is closed.
MAX_BODY_BYTES=1048576

# debug | info | warn | error
LOG_LEVEL=info
